---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found | WeCollab8" description="The page you are looking for could not be found.">
  <section class="mx-auto min-h-[60vh] max-w-7xl px-5 py-20 md:px-8 md:py-28 lg:px-10">
    <p class="eyebrow">404 / Not found</p>
    <h1 class="mt-5 max-w-[10ch] font-display text-5xl leading-tight text-ink md:text-6xl">This page isn't here.</h1>
    <p class="mt-5 max-w-lg text-base leading-7 text-muted">The address may have changed. Head back to the homepage or browse our services.</p>
    <div class="mt-8 flex flex-wrap gap-x-7 gap-y-4">
      <a href="/" class="text-link text-sm font-semibold text-forest">Go to homepage &rarr;</a>
      <a href="/services/" class="text-link text-sm font-semibold text-forest">Browse services &rarr;</a>
    </div>
  </section>
</SiteLayout>