---
import ServiceList from '../../components/ServiceList.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { services } from '../../data/services';
---

<SiteLayout title="Services | WeCollab8" description="Hands-on cloud, integration, automation and security services for enterprise technology teams.">
  <section class="mx-auto max-w-7xl px-5 pb-20 pt-16 md:px-8 md:pb-24 md:pt-20 lg:px-10">
    <p class="eyebrow">Services</p>
    <div class="mt-5 grid gap-8 md:grid-cols-[1fr_0.8fr] md:items-end">
      <h1 class="max-w-[13ch] font-display text-5xl leading-tight text-ink md:text-6xl">Practical expertise for complex systems.</h1>
      <p class="max-w-xl text-base leading-7 text-muted">We work across cloud platforms, application integration, enterprise automation and security, from architecture through implementation and support.</p>
    </div>
    <div class="mt-14">
      <ServiceList services={services} />
    </div>
    <div class="mt-16 flex flex-col gap-5 border-l-2 border-rust pl-6 md:flex-row md:items-center md:justify-between md:gap-10">
      <p class="max-w-2xl text-lg leading-8 text-ink">Need a specialist perspective on a complex environment or integration challenge?</p>
      <a href="mailto:admin@wecollab8.co.za" class="text-link w-fit shrink-0 text-sm font-semibold text-forest">Start a conversation &rarr;</a>
    </div>
  </section>
</SiteLayout>