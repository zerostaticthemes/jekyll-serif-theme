---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout title="Contact | WeCollab8" description="Contact WeCollab8 Technology Holdings to discuss cloud, integration, automation or security work.">
  <section class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-[1fr_0.8fr] md:px-8 md:py-24 lg:px-10">
    <div>
      <p class="eyebrow">Contact</p>
      <h1 class="mt-5 max-w-[11ch] font-display text-5xl leading-tight text-ink md:text-6xl">Let's work through it together.</h1>
      <p class="mt-6 max-w-xl text-base leading-8 text-muted">Tell us about the systems, integrations or platform challenges your team is working through.</p>
    </div>
    <div class="self-center border-y border-line py-7">
      <p class="text-xs font-bold uppercase tracking-normal text-rust">Email</p>
      <a href="mailto:admin@wecollab8.co.za" class="text-link mt-3 inline-block break-all font-display text-2xl text-ink md:text-3xl">admin@wecollab8.co.za</a>
      <p class="mt-4 max-w-md text-sm leading-6 text-muted">For cloud, integration, enterprise automation and security enquiries.</p>
    </div>
  </section>
</SiteLayout>