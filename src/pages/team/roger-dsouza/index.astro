---
import SiteLayout from '../../../layouts/SiteLayout.astro';
---

<SiteLayout title="Roger D'Souza | WeCollab8" description="Roger D'Souza, Director of WeCollab8 Technology Holdings.">
  <section class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-[0.7fr_1.3fr] md:px-8 md:py-24 lg:px-10">
    <div class="flex aspect-square max-w-sm flex-col justify-between bg-forest p-7 text-white md:p-9" aria-label="Roger D'Souza, Director">
      <span class="text-xs font-bold uppercase tracking-normal text-[#e8a083]">WeCollab8 / Leadership</span>
      <span class="font-display text-8xl leading-none">RD</span>
      <span class="text-sm font-medium">Roger D'Souza / Director</span>
    </div>
    <div class="self-center">
      <a href="/team/" class="text-sm text-muted no-underline hover:text-forest">&larr; Team</a>
      <p class="eyebrow mt-10">Director</p>
      <h1 class="mt-3 font-display text-5xl text-ink md:text-6xl">Roger D'Souza</h1>
      <div class="mt-7 max-w-2xl space-y-5 text-base leading-8 text-muted">
        <p>Roger has worked across enterprise monitoring and automation, infrastructure management and IT service management.</p>
        <p>He looks for practical ways to improve efficiency, with a particular interest in automation. His experience includes enterprise software delivered on-premises, in virtualized environments and in the cloud.</p>
      </div>
      <a href="mailto:admin@wecollab8.co.za" class="text-link mt-8 inline-block text-sm font-semibold text-forest">Contact WeCollab8 &rarr;</a>
    </div>
  </section>
</SiteLayout>