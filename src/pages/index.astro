---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout>
  <section class="overflow-hidden bg-paper">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 pb-14 pt-12 md:px-8 md:pb-16 md:pt-16 lg:grid-cols-[1.02fr_0.98fr] lg:gap-16 lg:px-10 lg:pb-20 lg:pt-20">
      <div class="max-w-2xl">
        <p class="eyebrow">Cloud / Integration / Automation / Security / AI / Data</p>
        <h1 class="mt-5 max-w-[12ch] font-display text-5xl leading-[1.04] text-ink sm:text-6xl lg:text-7xl">Technology that works together.</h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-muted">Hands-on engineering expertise to help IT leaders connect, modernize and operate complex enterprise systems.</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href="/services/" class="inline-flex items-center gap-4 bg-forest px-5 py-4 text-sm font-semibold text-white no-underline transition-colors hover:bg-rust">
            Explore our services <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="mailto:admin@wecollab8.co.za" class="text-link text-sm font-semibold text-ink">Talk to an engineer</a>
        </div>
      </div>

      <div class="architecture-grid relative mx-auto aspect-square w-full max-w-136 border border-line p-5 sm:p-8" role="img" aria-label="Cloud, integration, automation, security, AI and data connected around enterprise systems">
        <div class="architecture-line architecture-line-horizontal"></div>
        <div class="architecture-line architecture-line-vertical"></div>
        <div class="relative grid h-full grid-cols-3 grid-rows-3 gap-2 sm:gap-4">
          <div class="architecture-node col-start-1 row-start-1 flex flex-col justify-between p-3 sm:p-4">
            <span class="text-[0.6rem] font-bold text-rust sm:text-xs">01</span>
            <span class="text-xs font-semibold uppercase tracking-normal text-ink sm:text-sm">Cloud</span>
          </div>
          <div class="architecture-node col-start-2 row-start-1 flex flex-col justify-between p-3 sm:p-4">
            <span class="text-[0.6rem] font-bold text-rust sm:text-xs">05</span>
            <span class="text-xs font-semibold uppercase tracking-normal text-ink sm:text-sm">AI</span>
          </div>
          <div class="architecture-node col-start-3 row-start-1 flex flex-col justify-between p-3 sm:p-4">
            <span class="text-[0.6rem] font-bold text-rust sm:text-xs">02</span>
            <span class="text-xs font-semibold uppercase tracking-normal text-ink sm:text-sm">Integration</span>
          </div>
          <div class="architecture-node col-start-1 row-start-3 flex flex-col justify-between p-3 sm:p-4">
            <span class="text-[0.6rem] font-bold text-rust sm:text-xs">03</span>
            <span class="text-xs font-semibold uppercase tracking-normal text-ink sm:text-sm">Automation</span>
          </div>
          <div class="architecture-node col-start-2 row-start-3 flex flex-col justify-between p-3 sm:p-4">
            <span class="text-[0.6rem] font-bold text-rust sm:text-xs">06</span>
            <span class="text-xs font-semibold uppercase tracking-normal text-ink sm:text-sm">Data</span>
          </div>
          <div class="architecture-node col-start-3 row-start-3 flex flex-col justify-between p-3 sm:p-4">
            <span class="text-[0.6rem] font-bold text-rust sm:text-xs">04</span>
            <span class="text-xs font-semibold uppercase tracking-normal text-ink sm:text-sm">Security</span>
          </div>
          <div class="architecture-hub col-start-2 row-start-2 flex flex-col items-center justify-center px-2 text-center">
            <span class="text-[0.55rem] font-semibold uppercase tracking-normal text-white/70 sm:text-[0.65rem]">Enterprise</span>
            <span class="mt-1 font-display text-base sm:text-xl">Systems</span>
          </div>
        </div>
        <p class="absolute bottom-2 left-5 text-[0.6rem] font-semibold uppercase tracking-normal text-muted sm:bottom-3 sm:left-8">Connected by design</p>
      </div>
    </div>

    <div class="border-y border-line bg-white/70">
      <div class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-4 px-5 py-5 sm:grid-cols-4 md:px-8 lg:px-10">
        <span class="text-xs font-semibold uppercase tracking-normal text-muted">Architecture to implementation</span>
        <span class="text-xs font-semibold uppercase tracking-normal text-muted">Cloud and data foundations</span>
        <span class="text-xs font-semibold uppercase tracking-normal text-muted">Integration and APIs</span>
        <span class="text-xs font-semibold uppercase tracking-normal text-muted">AI, automation and security</span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-24 lg:px-10">
    <div class="grid gap-8 md:grid-cols-[0.7fr_1.3fr] md:items-end">
      <div>
        <p class="eyebrow">Where we work</p>
        <h2 class="mt-4 max-w-[13ch] font-display text-4xl leading-tight text-ink md:text-5xl">Deep expertise. Connected thinking.</h2>
      </div>
      <p class="max-w-2xl text-base leading-7 text-muted md:justify-self-end">From cloud and data platforms to enterprise automation and applied AI, we bring practical engineering experience to the systems and integrations your teams rely on.</p>
    </div>

    <div class="mt-12 grid border-y border-line md:grid-cols-2">
      <a href="/services/cloud-management/" class="group border-b border-line py-7 no-underline md:border-r md:px-7 md:py-8">
        <span class="text-xs font-bold text-rust">01 / CLOUD & PLATFORM</span>
        <span class="mt-3 flex items-center justify-between gap-4 font-display text-2xl text-ink">Build a stronger foundation <span class="text-rust transition-transform group-hover:translate-x-1">&rarr;</span></span>
        <span class="mt-3 block max-w-md text-sm leading-6 text-muted">Architecture, migration and engineering for cloud and cloud-native environments.</span>
      </a>
      <a href="/services/integration/" class="group border-b border-line py-7 no-underline md:px-7 md:py-8">
        <span class="text-xs font-bold text-rust">02 / INTEGRATION & APIs</span>
        <span class="mt-3 flex items-center justify-between gap-4 font-display text-2xl text-ink">Make systems work as one <span class="text-rust transition-transform group-hover:translate-x-1">&rarr;</span></span>
        <span class="mt-3 block max-w-md text-sm leading-6 text-muted">Connect applications and platforms with open standards and considered API design.</span>
      </a>
      <a href="/services/ca-services/" class="group border-b border-line py-7 no-underline md:border-r md:px-7 md:py-8">
        <span class="text-xs font-bold text-rust">03 / ENTERPRISE AUTOMATION</span>
        <span class="mt-3 flex items-center justify-between gap-4 font-display text-2xl text-ink">Reduce operational friction <span class="text-rust transition-transform group-hover:translate-x-1">&rarr;</span></span>
        <span class="mt-3 block max-w-md text-sm leading-6 text-muted">Automate work across applications, platforms and enterprise environments.</span>
      </a>
      <a href="/services/security/" class="group border-b border-line py-7 no-underline md:px-7 md:py-8">
        <span class="text-xs font-bold text-rust">04 / SECURITY</span>
        <span class="mt-3 flex items-center justify-between gap-4 font-display text-2xl text-ink">Secure every connection <span class="text-rust transition-transform group-hover:translate-x-1">&rarr;</span></span>
        <span class="mt-3 block max-w-md text-sm leading-6 text-muted">Apply open standards and API security to protect enterprise services.</span>
      </a>
      <a href="/services/ai-consulting/" class="group border-b border-line py-7 no-underline md:border-r md:px-7 md:py-8">
        <span class="text-xs font-bold text-rust">05 / AI CONSULTING</span>
        <span class="mt-3 flex items-center justify-between gap-4 font-display text-2xl text-ink">Put AI to practical use <span class="text-rust transition-transform group-hover:translate-x-1">&rarr;</span></span>
        <span class="mt-3 block max-w-md text-sm leading-6 text-muted">Explore use cases and design responsible AI solutions around your environment.</span>
      </a>
      <a href="/services/data-engineering/" class="group py-7 no-underline md:px-7 md:py-8">
        <span class="text-xs font-bold text-rust">06 / DATA ENGINEERING</span>
        <span class="mt-3 flex items-center justify-between gap-4 font-display text-2xl text-ink">Build trusted data foundations <span class="text-rust transition-transform group-hover:translate-x-1">&rarr;</span></span>
        <span class="mt-3 block max-w-md text-sm leading-6 text-muted">Connect source systems and make dependable data ready for analytics and AI.</span>
      </a>
    </div>
  </section>

  <section class="bg-forest text-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 md:grid-cols-[0.8fr_1.2fr] md:items-center md:px-8 md:py-20 lg:px-10">
      <div>
        <p class="text-xs font-semibold uppercase tracking-normal text-[#e8a083]">A practical engineering partner</p>
        <h2 class="mt-4 max-w-[12ch] font-display text-4xl leading-tight md:text-5xl">From the first design to the day-to-day.</h2>
      </div>
      <div>
        <p class="max-w-2xl text-base leading-7 text-white/80">WeCollab8 brings architecture, implementation and post-implementation support together, helping teams move from complex technology constraints to systems they can operate with confidence.</p>
        <a href="/about/" class="mt-7 inline-flex items-center gap-3 text-sm font-semibold text-white underline decoration-[#e8a083] underline-offset-4">How we work <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-16 md:flex-row md:items-center md:justify-between md:px-8 md:py-20 lg:px-10">
    <div>
      <p class="eyebrow">Start a conversation</p>
      <h2 class="mt-3 font-display text-4xl text-ink md:text-5xl">What are you working through?</h2>
    </div>
    <a href="mailto:admin@wecollab8.co.za" class="inline-flex w-fit items-center gap-4 border border-forest px-5 py-4 text-sm font-semibold text-forest no-underline transition-colors hover:bg-forest hover:text-white">
      admin@wecollab8.co.za <span aria-hidden="true">&rarr;</span>
    </a>
  </section>
</SiteLayout>